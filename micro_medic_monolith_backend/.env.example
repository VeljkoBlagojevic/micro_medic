# Spring Boot Application Configuration Example
# Copy this file to .env and fill in your actual values

# Application Name
SPRING_APPLICATION_NAME=micro_medic_monolith_backend

# Server Settings
SERVER_PORT=8080
SERVER_ERROR_INCLUDE_MESSAGE=never

# Active Profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

## MySQL Database Configuration
MYSQL_URL=jdbc:mysql://localhost:3306/micro_medic_monolith_backend?useSSL=false&serverTimezone=UTC
MYSQL_ROOT_USERNAME=root
MYSQL_ROOT_PASSWORD=mysqlpassword1!
MYSQL_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# Flyway Database Migration Settings
SPRING_JPA_DEFER_DATASOURCE_INITIALIZATION=false
SPRING_SQL_INIT_MODE=never
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
# Fail on misnamed migration instead of silently skipping
SPRING_FLYWAY_VALIDATE_MIGRATION_NAMING=true

# JWT Configuration
# IMPORTANT: Generate a secure key (at least 256 bits). Example using openssl:
#   echo -n "your-secret-key" | base64
# Or use Java's Jwts.SIG.HS256.key() helper if available
JWT_SECRET=Ntdc4AgH+t02cTUuxBSbYJmhIqyg2tJa23Y+xHeL1zo=
JWT_EXPIRATION_MS=3600000

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting Configuration
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# Management Endpoints
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized

# Cache Configuration
SPRING_CACHE_TYPE=simple
