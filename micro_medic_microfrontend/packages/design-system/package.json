{
    "name": "@micro-medic/design-system",
    "version": "1.0.0",
    "description": "Design system for the Micro Medic MicroFrontend",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./tokens.css": "./src/tokens.css",
        "./global.css": "./src/global.css",
        "./src/tokens.css": "./src/tokens.css",
        "./src/global.css": "./src/global.css"
    },
    "sideEffects": [
        "./src/index.ts",
        "./src/components/*.ts",
        "*.css"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "lit": "^3.3.3"
    },
    "devDependencies": {
        "typescript": "^6.0.3"
    }
}