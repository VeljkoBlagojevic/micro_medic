{
    "compilerOptions": {
        "target": "es2024",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["esnext", "dom", "dom.iterable", "ES2020"],
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "paths": {
            "@micro-medic/shared-types": ["./packages/shared-types/src/index.ts"],
            "@micro-medic/api-client": ["./packages/api-client/src/index.ts"],
            "@micro-medic/shared-store": ["./packages/shared-store/src/index.ts"],
            "@micro-medic/design-system": ["./packages/design-system/src/index.ts"],
            "@micro-medic/design-system-react": ["./packages/design-system-react/src/index.ts"],
            "@micro-medic/design-system-angular": ["./packages/design-system-angular/src/index.ts"]
        }
    },
    "exclude": ["./node_modules", "./dist", "./build", "./coverage", "./scripts", "./tests"]
}